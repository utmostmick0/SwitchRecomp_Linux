+    if(c->stage==ST_GS && !is_out && B(w,8,8)!=255){
+      const char* ix=T("int(min(%s,%uu))",R(c,B(w,8,8)),c->si->gs_input_vertices? c->si->gs_input_vertices-1 : 0);
+      for(u32 k=0;k<n;k++) setr(c,d+k,attr_read_idx(c,addr+k*4,0,ix));
