@@ -2,6 +2,75 @@
 #ifndef SWR_AUDIO_H
 #define SWR_AUDIO_H
 #include "rt.h"
+#include <stddef.h>
+
+/* HOS audren:u AudioRendererParameter. This is a wire structure, not a host
+   configuration struct: preserve its exact 0x34-byte layout on every ABI. */
+#pragma pack(push, 1)
+typedef struct AudioRendererParameter {
+  u32 sample_rate;                 /* 0x00 */
+  u32 sample_count;                /* 0x04 */
+  u32 mix_buffer_count;            /* 0x08 */
+  u32 submix_count;                /* 0x0C */
+  u32 voice_count;                 /* 0x10 */
+  u32 sink_count;                  /* 0x14 */
+  u32 effect_count;                /* 0x18 */
+  u32 performance_frame_count;     /* 0x1C */
+  u8 is_voice_drop_enabled;        /* 0x20 */
+  u8 unknown_21;
+  u8 unknown_22;
+  u8 execution_mode;               /* 0x23 */
+  u32 splitter_count;              /* 0x24 */
+  u32 num_splitter_send_channels;  /* 0x28 */
+  u32 unknown_2c;                  /* 0x2C */
+  u32 revision;                    /* 0x30 */
+} AudioRendererParameter;
+#pragma pack(pop)
+
+#if defined(__cplusplus)
+static_assert(alignof(AudioRendererParameter)==1, "AudioRendererParameter wire alignment");
+#define SWR_AUDIO_STATIC_ASSERT static_assert
+#else
+_Static_assert(_Alignof(AudioRendererParameter)==1, "AudioRendererParameter wire alignment");
+#define SWR_AUDIO_STATIC_ASSERT _Static_assert
+#endif
+SWR_AUDIO_STATIC_ASSERT(sizeof(AudioRendererParameter)==0x34, "AudioRendererParameter wire size");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,sample_rate)==0x00, "AudioRendererParameter sample_rate offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,sample_count)==0x04, "AudioRendererParameter sample_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,mix_buffer_count)==0x08, "AudioRendererParameter mix_buffer_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,submix_count)==0x0C, "AudioRendererParameter submix_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,voice_count)==0x10, "AudioRendererParameter voice_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,sink_count)==0x14, "AudioRendererParameter sink_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,effect_count)==0x18, "AudioRendererParameter effect_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,performance_frame_count)==0x1C, "AudioRendererParameter performance_frame_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,is_voice_drop_enabled)==0x20, "AudioRendererParameter voice_drop offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,unknown_21)==0x21, "AudioRendererParameter unknown_21 offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,unknown_22)==0x22, "AudioRendererParameter unknown_22 offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,execution_mode)==0x23, "AudioRendererParameter execution_mode offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,splitter_count)==0x24, "AudioRendererParameter splitter_count offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,num_splitter_send_channels)==0x28, "AudioRendererParameter splitter_channels offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,unknown_2c)==0x2C, "AudioRendererParameter unknown offset");
+SWR_AUDIO_STATIC_ASSERT(offsetof(AudioRendererParameter,revision)==0x30, "AudioRendererParameter revision offset");
+#undef SWR_AUDIO_STATIC_ASSERT
+
+/* IPC fields are Switch little-endian values. Decode into the packed wire type
+   explicitly so host alignment/endianness cannot alter the count fields. */
+static inline u32 audio_parameter_u32(const u8* p){
+  return (u32)p[0] | ((u32)p[1]<<8) | ((u32)p[2]<<16) | ((u32)p[3]<<24);
+}
+static inline int audio_renderer_parameter_read(const IpcCtx* c, AudioRendererParameter* p){
+  if(!c || !p || !c->raw || c->raw_size<sizeof(*p)) return 0;
+  const u8* b=c->raw;
+  p->sample_rate=audio_parameter_u32(b+0x00); p->sample_count=audio_parameter_u32(b+0x04);
+  p->mix_buffer_count=audio_parameter_u32(b+0x08); p->submix_count=audio_parameter_u32(b+0x0C);
+  p->voice_count=audio_parameter_u32(b+0x10); p->sink_count=audio_parameter_u32(b+0x14);
+  p->effect_count=audio_parameter_u32(b+0x18); p->performance_frame_count=audio_parameter_u32(b+0x1C);
+  p->is_voice_drop_enabled=b[0x20]; p->unknown_21=b[0x21]; p->unknown_22=b[0x22]; p->execution_mode=b[0x23];
+  p->splitter_count=audio_parameter_u32(b+0x24); p->num_splitter_send_channels=audio_parameter_u32(b+0x28);
+  p->unknown_2c=audio_parameter_u32(b+0x2C); p->revision=audio_parameter_u32(b+0x30);
+  return 1;
+}
+
