-        if p.get('file_mode') == 'binary':
-            new = prefix.encode()
-            if len(new) > len(old): continue
-            out = bytearray()
-            i = 0
-            while True:
-                j = data.find(old, i)
-                if j < 0: out += data[i:]; break
-                k = data.find(b'\0', j)
-                if k < 0: k = len(data)
