diff --git a/codegen.py b/codegen.py
index 0fa6ea7..8fb47d8 100644
--- a/codegen.py
+++ b/codegen.py
@@ -371,4 +371,3 @@ def interp_body(r, step):
     if k == 'svc': return 'c->pc=pc+4; c->rt->svc(c,%s); goto N_;' % r[1]
