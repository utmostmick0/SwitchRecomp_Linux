@@ -58,18 +59,19 @@ static int host_open(void){ WAVEFORMATEX f; memset(&f,0,sizeof f); f.wFormatTag=
   LOG("audio: Windows waveOut, 48000 Hz stereo PCM16 enabled\n"); return 1;
 }
