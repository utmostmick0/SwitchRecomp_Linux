diff --git a/runtime/audio_queue.h b/runtime/audio_queue.h
index 2496897..c73f655 100644
--- a/runtime/audio_queue.h
+++ b/runtime/audio_queue.h
@@ -35,15 +35,16 @@ static void swr_aq_pop(SwrAudioQueue* q){
   q->head=(q->head+1)%q->capacity; q->count--; q->consumed++;
 }
 static void swr_aq_render(SwrAudioQueue* q,float* out,unsigned frames,int smooth){
-  /* 100ms is the adaptive reserve. a producer giving half real time ends up around half speed, playback never
-     speeds up to throw away backlog */
-  double target=smooth?(double)q->count/4800.0:1.0;
+  /* Keep the normal reserve to 20ms for A/V sync. Slow down only when the queue falls
+     below that reserve; a healthy producer stays at the original pitch and rate. */
+  double target=smooth?(double)q->count/960.0:1.0;
   if(target>1) target=1; if(target<.02) target=.02;
   if(!smooth) q->rate=1;
   for(unsigned i=0;i<frames;i++){
     if(!q->primed){
       q->waiting++;
-      if(q->count && (q->count>=2400 || q->waiting>=2400)){
+      /* Prime to 20ms. A full reserve starts at normal rate with less A/V delay. */
+      if(q->count && (q->count>=960 || q->waiting>=960)){
         swr_aq_pop(q); q->primed=1; q->envelope=1; q->rate=target;
       } else { out[i*2]=out[i*2+1]=0; continue; }
     }
