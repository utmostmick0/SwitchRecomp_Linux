+  u32 nf=0; r=vkGetPhysicalDeviceSurfaceFormatsKHR(s_vk.physical,s_vk.surface,&nf,NULL);
+  if(r!=VK_SUCCESS || !nf){ vk_log_error("surface formats",r); return 0; }
