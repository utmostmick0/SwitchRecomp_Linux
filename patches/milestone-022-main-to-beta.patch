   int n=0; for(;ops[n].pat;n++){ u64 m=0,v=0; int bits=0; for(int i=0;i<16;i++){ char ch=ops[n].pat[i]; u64 bit=1ull<<(63-i); if(ch=='0'||ch=='1'){ m|=bit; bits++; if(ch=='1') v|=bit; } } ops[n].mask=m; ops[n].val=v; ops[n].bits=bits; }
